# ============================================
# MemoryVerse AI — Backend Environment Config
# ============================================

# Groq & HuggingFace
GROQ_API_KEY=gsk_your_groq_api_key_here
# Must match a model Groq currently serves, and match the default in app/config.py.
# Older names like llama-3.3-70b-versatile / llama3-70b-8192 are RETIRED and return
# 404 model_not_found — which never fails at startup, only surfaces as
# "I couldn't generate an answer at this time" on every query. Leave unset to
# inherit the config default, or set it explicitly as below.
GROQ_MODEL=openai/gpt-oss-120b
HF_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_PREFIX=memoryverse

# Server
HOST=0.0.0.0
# Leave PORT unset on Render/Fly/Cloud Run — they inject it, and setting it
# here (or in the dashboard) overrides theirs and breaks port detection /
# health check. The app already defaults to 8000; uncomment only for a fixed
# local port.
# PORT=8000
DEBUG=true

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Upload
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads

# LangChain
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
