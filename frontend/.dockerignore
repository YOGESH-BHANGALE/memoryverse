# Env — NEXT_PUBLIC_* are inlined into the CLIENT bundle at build time, so a
# baked-in localhost URL ships to every user's browser. Never copy .env.local
# into the image; pass NEXT_PUBLIC_API_URL via --build-arg instead (see Dockerfile).
.env
.env.*
!.env.example
!.env.local.example

# Deps & build output — rebuilt inside the image; host copies are OS-specific
# and would clobber the clean `npm ci` layer.
node_modules/
.next/
out/
build/

# Misc
npm-debug.log*
yarn-error.log*
.DS_Store
*.log
