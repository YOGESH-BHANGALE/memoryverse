# ============================================
# MemoryVerse AI — Frontend Environment
# ============================================

# Local dev: point the browser at your local backend.
# NOTE: Next.js inlines NEXT_PUBLIC_* at BUILD time into the client bundle, so a
# production / Docker build must set this to the PUBLIC backend origin
# (e.g. https://memoryverse-backend-bju3.onrender.com), NOT localhost. If unset,
# the app falls back to the hosted backend for any non-localhost origin
# (see src/lib/api.ts). For Docker, pass it via --build-arg (see frontend/Dockerfile).
NEXT_PUBLIC_API_URL=http://localhost:8000
